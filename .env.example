# aigw Environment Variables
# Copy to .env and customize for your deployment.
#
# Layout: Required / Runtime & Server / UI login / Database (docker-compose) /
# Optional & Advanced / aigw-migrate (upstream litellm) / Real-API BDD tests /
# Test-only (do not set in production).
#
# For docker-compose: docker-compose.allinone.yml hardcodes
# DATABASE_URL=postgres://aigw:aigw@postgres:5432/aigw, so POSTGRES_PASSWORD MUST
# stay "aigw" there or the app's DB connection will mismatch the container.

# ── Required ──
# Admin login password + request auth master key. Server reads it via clap
# (--master-key) or config.yaml general_settings.master_key fallback.
# docker-compose.yml requires it via ${MASTER_KEY:?}.
MASTER_KEY=sk-master-change-me

# ── Runtime & Server (read by the aigw binary) ──
# Server database connection string. Precedence: --database-url / DATABASE_URL
# > config.yaml general_settings.database_url > sqlite:aigw.db.
DATABASE_URL=postgres://aigw:aigw@postgres:5432/aigw
# Runtime master key for decrypting CREDENTIALS / encrypted model fields.
# Priority: AIGW_MASTER_KEY env > config table general_settings.master_key.
# If neither exists the server still boots but encrypted fields stay undecrypted.
AIGW_MASTER_KEY=
# tracing filter (RUST_LOG=debug,aigw_core=warn). Default "info".
RUST_LOG=info
# Deployment mode: saas | onprem | test. In "test" mode the OPENAI_* env
# fallback for unresolvable models is disabled (fail fast model_not_found).
DEPLOYMENT_MODE=onprem
# Fallback upstream API key for chat/embedding models absent from proxy_models
# (non-test mode). Also seeds the "openai" provider and fills missing api_key.
OPENAI_API_KEY=
# Alias fallback for OPENAI_API_KEY (litellm naming), read only when
# OPENAI_API_KEY is absent.
OPENAPI_KEY=
# Fallback upstream base URL for the env fallback path.
OPENAI_BASE_URL=https://api.openai.com/v1
# Alias fallback for OPENAI_BASE_URL (litellm naming).
OPENAPI_BASE_URL=https://api.openai.com/v1
# Seeds the "anthropic" provider (base_url https://api.anthropic.com/v1).
ANTHROPIC_API_KEY=
# S3 credentials are ONLY effective when referenced by ${VAR} placeholders in
# config.yaml body_archive.s3 (e.g. access_key_id: ${AWS_ACCESS_KEY_ID}).
# They are NOT auto-loaded from the environment.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── UI login (/v2/login, litellm-compatible admin login) ──
# Admin username accepted for /v2/login. Default "admin".
# UI_USERNAME=admin
# Admin password accepted for /v2/login, in addition to the master key.
# Defaults to the master key when unset.
# UI_PASSWORD=
# Session cookie lifetime for the /v2/login JWT (suffix h/m, e.g. 24h or 30m).
# Default 24h.
# LITELLM_UI_SESSION_DURATION=24h

# ── Database (docker-compose) ──
# Docker-only: postgres password substituted into docker-compose*.yml.
# Mandatory via ${POSTGRES_PASSWORD:?}. Allinone hardcodes DATABASE_URL with
# aigw/aigw — keep POSTGRES_PASSWORD=aigw for that compose file.
POSTGRES_PASSWORD=aigw
# Docker-only: MySQL root password for docker-compose.db.yml / test.yml
# (mandatory via ${MYSQL_ROOT_PASSWORD:?}).
# MYSQL_ROOT_PASSWORD=strong-mysql-password
# Docker-only: host port mapped to the allinone postgres 5432.
# PG_PORT=5432
# Docker-only: host port mapped to the aigw container port 4000.
# SERVER_PORT=4000

# ── aigw-migrate (upstream litellm migration) ──
# NOTE: for reverse migration (aigw -> litellm, scripts/rollback.sh) the SAME
# names point at the OPPOSITE endpoints: source=AIGW_DATABASE_URL,
# target=AIGW_UPSTREAM_DB_URL, key=AIGW_MASTER_KEY.
# Source litellm DB URL (remote-import/precheck/sync-source). Required by
# aigw-migrate unless --source-url is given.
# AIGW_UPSTREAM_DB_URL=postgresql://user:pass@host:5432/litellm
# Target aigw DB URL (remote-import/precheck/sync-target). Required by
# aigw-migrate unless --target-url is given.
# AIGW_DATABASE_URL=
# Target (aigw) encryption master key (remote-import/precheck). Required
# unless --target-master-key is given.
# AIGW_MASTER_KEY=
# Optional source aigw DB URL for the `sync` subcommand (--source-url/-s).
# Falls back to AIGW_UPSTREAM_DB_URL.
# AIGW_SYNC_SOURCE_URL=
# Optional target aigw DB URL for the `sync` subcommand (--target-url/-t).
# Falls back to AIGW_DATABASE_URL.
# AIGW_SYNC_TARGET_URL=
# Upstream litellm FIELD-ENCRYPTION key (LiteLLM_Config.general_settings.master_key),
# NOT the API-auth `Authorization: Bearer` key. Used by export_fixtures to
# decrypt litellm_params/credential_values. Leave unset to auto-extract from the
# upstream DB. Also consumed by the BDD migration-sync/rollback steps.
# AIGW_UPSTREAM_ENCRYPT_KEY=<upstream litellm field-encryption key>

# ── Real-API BDD tests (task bdd-real / bdd-real-sqlite/pg/mysql) ──
# These vars are bridged by Taskfile: OPENAPI_KEY -> OPENAI_API_KEY, etc.
# Base URL of the aigw server under test (trailing /v1 is stripped).
# AIGW_BASE_URL=http://localhost:4000/v1
# Master key of the target server (also used as the runtime decryption key).
# AIGW_MASTER_KEY=sk-master-of-target-server
# Upstream litellm DB URL for migration/sync + spend real scenarios; unset
# scenarios are SKIPPED (not failed).
# AIGW_UPSTREAM_DB_URL=postgresql://user:pass@host:5432/litellm
# Optional u8 filter passed to aigw-migrate remote_import_run_filtered.
# AIGW_MIGRATE_STEP=1
# Model used for real requests: AIGW_REAL_MODEL > OPENAPI_MODEL > gpt-4.
# Test-only, not read by the server runtime.
# AIGW_REAL_MODEL=gpt-4
# OPENAPI_MODEL=gpt-4

# ── Test-only (do NOT set in production) ──
# "1" -> start the aigw-server subprocess on a random port (mock tests use an
# in-process sqlite::memory: DB instead).
# AIGW_TEST_START_SERVER=1
# Opt-in test-DB lifecycle: sqlite | postgres | mysql. Unset -> no auto
# create/drop. AIGW_TEST_DB_URL is then auto-set by the harness.
# AIGW_TEST_DB_DRIVER=postgres
# AIGW_TEST_DB_HOST=localhost
# AIGW_TEST_DB_PORT=5432
# AIGW_TEST_DB_USER=postgres
# AIGW_TEST_DB_PASS=postgres
# "1" -> skip dropping the test DB after the run (debugging aid).
# AIGW_TEST_KEEP_DB=1
# "1" -> only run @real_api BDD scenarios; mock steps become no-ops.
# AIGW_REAL_API=1
# "1" -> run the #[ignore]d live-S3 probes in aigw-core body_archive/writer.rs
# against the hardcoded probe endpoint 9.135.87.221:8001.
# AIGW_S3_LIVE=1
# Scales the AIGW_S3_LIVE probe payload in MiB (default 9).
# AIGW_S3_PROBE_MB=300
# hack/ python scripts: gateway base URL (no _URL suffix) and master key sent
# as x-api-key. NOTE: three hack scripts hardcode a real-looking key default
# (sk-ZiYEpatzdI9Enb_L0tujXA) — prefer setting API_KEY explicitly.
# AIGW_BASE=http://localhost:4000
# API_KEY=
