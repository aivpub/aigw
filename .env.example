# aigw Environment Variables
# Copy to .env and customize for your deployment.
#
# The defaults below match docker-compose.allinone.yml — you can
# `docker compose -f docker-compose.allinone.yml up -d` without any changes.
# For production (docker-compose.yml), set DATABASE_URL to your external DB.

# ── Required ──
MASTER_KEY=sk-master-change-me

# ── Database (defaults to the all-in-one PostgreSQL) ──
DATABASE_URL=postgres://aigw:aigw@postgres:5432/aigw
POSTGRES_PASSWORD=aigw
# PG_PORT=5432

# ── Optional ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RUST_LOG=info
DEPLOYMENT_MODE=onprem
SERVER_PORT=4000

# ── Real API BDD test configuration ──
# Set these in your .env before running `task bdd-real`:
# AIGW_BASE_URL=http://localhost:4000/v1
# AIGW_MASTER_KEY=sk-master-of-target-server

# ── Upstream litellm migration (task bdd-real-pg / sqlite / mysql) ──
# AIGW_UPSTREAM_DB_URL=postgresql://user:pass@host:5432/litellm
# AIGW_UPSTREAM_ENCRYPT_KEY=<upstream litellm FIELD-ENCRYPTION key>
#   ↑ the key stored in LiteLLM_Config.general_settings.master_key,
#     NOT the API-auth master key used for `Authorization: Bearer`.
#     They can differ in real deployments. Leave unset to auto-extract
#     from the upstream DB.
# OPENAPI_KEY=<upstream litellm API-auth key, used for /chat/completions env fallback>
# OPENAPI_BASE_URL=http://upstream-litellm:4000/v1
